  "milestones": [
    {
      "date": "2027-07-31",
      "description": "Wrexham AFC finish the European International Cup group stage with a perfect record — wins over Mallorca (2-0), M'gladbach (2-0), and RCD Espanyol (3-0), the last capped by Leo Sauer's Man of the Match display."
    },
    {
      "date": "2027-07-31",
      "description": "Juan Cruz Vargas (17) loaned to Ipswich Town for the 2027-28 season, seeking senior development minutes away from Wrexham's crowded CAM options."
    },
    {
      "date": "2027-08-25",
      "description": "Wrexham AFC sign Gabonese striker Musa Tine (17) as a free agent, agreeing a 4-year deal worth $17,000/week plus a $175,000 signing bonus. The 68-rated forward gives the club a genuine young No. 9 option behind Obi while Yacel Amrizi continues his recovery from injury."
    },
    {
      "date": "2027-08-25",
      "description": "FA Community Shield final confirmed: Wrexham AFC (Premier League champions) vs Manchester City (FA Cup holders), Wembley Stadium, Saturday 7 August 2027, kickoff 5:00 PM — the club's first-ever Community Shield appearance."
    },
    {
      "date": "2027-07-01",
      "description": "Pre-season loan business: seven players sent out for 2027-28 development minutes, including academy graduates Stephane Bertrand (Carrarese Calcio, 1yr) and Nathan Salaun (Barnet, 2yr), both promoted to the senior squad and loaned out the same day. Also out: Fabricio Sandoval (Hull City, 2yr), Nico Kopp (FC Basel 1893, 1yr), Vittorio Martini (CD Castellon, 1yr), Matthieu Brunel (West Brom, 1yr), and Lilian Faure (Bristol City, 1yr)."
    },
    {
      "date": "2027-08-24",
      "description": "Wrexham AFC sign Polish goalkeeper Adrian Kaczmarek (17) from Club Atlético Vélez Sarsfield for $12.7M, agreeing a 4-year deal at $6,200/week. Tagged 'World Class Prospect Goalkeeper' by the club's scouting network (Potential 84-90), he slots in as rotation depth behind Okonkwo and Klaverboer."
    },
    {
      "date": "2027-07-15",
      "description": "Pre-season loan business continues: Santiago Ortega loaned to Watford (1yr, 12 Jul), Emiliano Bianchi loaned to Jagiellonia (2yr, 14 Jul), and Bailey Cadamarteri loaned to Fulham (2yr, 15 Jul, after an initial loan proposal was rejected)."
    },
    {
      "date": "2027-05-26",
      "description": "Premier League Team of the Season announced — no Wrexham player named, despite the club winning the title. XI: Donnarumma (GK); Mauro Jr, Gvardiol, Thiaw, Frimpong; B. Barcola, B. Fernandes, Traoré, Saka; Gyökeres, Haaland."
    },
    {
      "date": "2027-08-28",
      "description": "Squad update"
    },
    {
      "date": "2027-08-15",
      "description": "Squad update — Yacel Amrizi back in first-team training, nearing full recovery from his torn quad injury (sustained 2027-05-15 vs Manchester City)."
    },
    {
      "date": "2027-08-15",
      "description": "Youth Academy Rush Tournament: Wrexham beat Fulham 5-3 (QF) and Nottingham Forest 4-1 (SF) before losing the final 1-4 to Burnley, ending the academy's run of four straight titles."
    }
  ],
